---
// Credits are listed once on the About page, not under each photo.
import { photos, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  // Above-the-fold photos load immediately; the rest load as the reader scrolls.
  eager?: boolean;
  sizes?: string;
}
const { name, eager = false, sizes = '(min-width: 820px) 540px, 100vw' } = Astro.props;
const p = photos[name];
const src = (w: number) => `/images/${p.file}-${w}.webp`;
---

<figure class="photo">
  <img
    src={src(640)}
    srcset={`${src(640)} 640w, ${src(1200)} 1200w`}
    sizes={sizes}
    width="1200"
    height="800"
    alt={p.alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</figure>
