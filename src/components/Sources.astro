---
interface Props {
  items: { title: string; url: string }[];
}
const { items } = Astro.props;
---

<!-- Collapsed for readers; the links stay in the HTML, so crawlers still see every source. -->
<details class="sources">
  <summary><h2 id="sources-h">Sources ({items.length})</h2></summary>
  <ol>
    {items.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
  </ol>
</details>
