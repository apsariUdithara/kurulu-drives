---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Sources from '../components/Sources.astro';
import { site, rates } from '../data/site';
import { faqPage } from '../lib/schema';

const s = rates.sedan.perDay;
const v = rates.van.perDay;

// One array feeds both the visible answers and the FAQPage JSON-LD, so they can never differ.
const groups = [
  {
    heading: 'Prices and payment',
    qas: [
      { q: 'How much does a private driver in Sri Lanka cost?', a: `US$${s} per day for an air-conditioned sedan (1–3 travellers) or US$${v} per day for a van (4–8 travellers). The rate includes fuel, highway tolls, parking and the driver's meals and room. Hotels and entrance tickets are extra.` },
      { q: 'How do I pay?', a: 'A 20% deposit by bank transfer or card confirms the booking. The rest is paid during the trip in cash (US dollars or rupees) or by card.' },
      { q: 'What is the cancellation policy?', a: 'Cancel up to 14 days before the trip starts and the deposit is refunded in full. After that the deposit is kept; nothing else is charged.' },
      { q: 'How much should we tip the driver?', a: 'Tipping is optional. Published guidance ranges from LKR 500 to US$20 a day; we suggest LKR 1,500–3,000 per day for good service, given in rupees at the end of the trip.' },
      { q: "Do we pay for the driver's food and accommodation?", a: "No. The driver's meals and room are included in the day rate. Many hotels have separate driver rooms; where they do not, we pay for a room nearby." },
    ],
  },
  {
    heading: 'Booking',
    qas: [
      { q: 'How far in advance should we book?', a: 'Two to four weeks is usually enough. For December to April, the busiest season, book one to two months ahead.' },
      { q: 'Do you have child seats?', a: 'Yes. Child seats and booster seats are free on request; tell us the children\'s ages when you book.' },
      { q: 'How much luggage fits in the car?', a: 'A sedan takes two large suitcases plus hand luggage. A van takes one large suitcase per person for up to six travellers; for seven or eight, tell us your luggage when you book.' },
      { q: 'Do the drivers speak English?', a: 'Yes. All our driver-guides speak English and Sinhala.' },
    ],
  },
  {
    heading: 'On the road',
    qas: [
      { q: 'Can we change the route during the trip?', a: 'Yes. Tell your driver the day before and the route changes; the day rate stays the same. We avoid long drives after dark where possible.' },
      { q: 'Is there a daily limit on kilometres or hours?', a: 'No kilometre limit. Most days run between about 8 am and 6 pm, and our itineraries keep driving to about 5 hours a day or less.' },
      { q: 'Can we take the train and have the driver meet us?', a: 'Yes. In 2026 the hill-country train runs from Nanu Oya to Ella; the Kandy end of the line is still closed after Cyclone Ditwah. Your driver drops you at Nanu Oya, drives your luggage to Ella and meets you at the station.' },
      { q: 'What happens if the car breaks down?', a: 'We send a replacement vehicle, normally within a few hours. Any day lost to a breakdown is not charged.' },
    ],
  },
  {
    heading: 'Safety and trust',
    qas: [
      { q: 'Is it safe to hire a private driver in Sri Lanka?', a: 'Hiring a driver is one of the most common ways to tour Sri Lanka, which had a record 2,362,521 tourist arrivals in 2025. To be safe with any driver: get a fixed written quote, check reviews on independent sites, and share your itinerary with someone at home.' },
      { q: 'Are your drivers licensed?', a: `${site.name} is a demo business and holds no licences. When you hire any driver in Sri Lanka, ask whether they hold a chauffeur-guide licence from the Sri Lanka Tourism Development Authority (SLTDA).` },
    ],
  },
];
const qas = groups.flatMap((g) => g.qas);

const sources = [
  { title: 'Ada Derana Biz English: December tourist arrivals drive Sri Lanka to record-breaking 2025', url: 'https://bizenglish.adaderana.lk/december-tourist-arrivals-drive-sri-lanka-to-record-breaking-2025/' },
  { title: 'SLTDA: Year in Review 2025', url: 'https://www.sltda.gov.lk/storage/common_media/Year_in_Review_2025_Final_updated_Report_2026_04_02.pdf' },
  { title: 'Sunday Times (21 June 2026): Podi Menike runs again from Nanu Oya to Badulla', url: 'https://www.sundaytimes.lk/260621/news/podi-menike-hits-the-tracks-from-nanu-oya-to-badulla-marking-latest-phase-of-restoration-646913.html' },
  { title: 'The Middle Age Wanderer: Tipping in Sri Lanka, your complete guide in 2026', url: 'https://themiddleagewanderer.com/guide-to-tipping-in-sri-lanka/' },
  { title: 'Rediscover Sri Lanka: Tipping in Sri Lanka 2026', url: 'https://rediscoversrilanka.com/tipping-in-sri-lanka-guide/' },
];
---

<Base
  title="FAQ: hiring a private driver in Sri Lanka"
  description="Answers on cost, payment, cancellation, child seats, luggage, route changes, the 2026 train, tipping, safety and licences when hiring a driver in Sri Lanka."
  crumbs={[{ name: 'FAQ', path: '/faq/' }]}
  schema={[faqPage(qas)]}
>
  <h1>Frequently asked questions about hiring a driver in Sri Lanka</h1>
  <p class="lead">
    Short answers to the {qas.length} questions travellers ask most before hiring a private driver in Sri Lanka. In short:
    US${s} a day for a sedan or US${v} for a van, with fuel, tolls and the driver's food and room included.
  </p>

  {groups.map((g) => (
    <section>
      <h2>{g.heading}</h2>
      {g.qas.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </section>
  ))}

  <section class="related">
    <h2>Related</h2>
    <ul>
      <li><a href="/pricing/">How much a private driver in Sri Lanka costs</a></li>
      <li><a href="/guides/tipping-and-driver-costs/">Tipping and driver costs in Sri Lanka</a></li>
      <li><a href="/guides/driver-vs-train/">Private driver vs train vs tuk-tuk, with the 2026 rail status</a></li>
      <li><a href="/guides/airport-transfers/">Colombo airport (CMB) transfers: times and prices</a></li>
    </ul>
  </section>

  <Cta />
  <AuthorBox />
  <Sources items={sources} />
</Base>
