---
import '../styles/global.css';
import { site } from '../data/site';
import { breadcrumbs } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; path: string }[]; // excluding Home
  schema?: object[];
}

const { title, description, crumbs = [], schema = [] } = Astro.props;
const base = Astro.site!;
const canonical = new URL(Astro.url.pathname, base).href;
const trail = [{ name: 'Home', path: '/' }, ...crumbs];
const ld = crumbs.length ? [...schema, breadcrumbs(base, trail)] : schema;

// "On this page" links: on inner pages, every question-style <h2> gets an id and a link,
// shown above the first one. Pages with fewer than 3 such headings get no list.
const toc: { id: string; label: string }[] = [];
let body = await Astro.slots.render('default');
if (crumbs.length) {
  body = body.replace(/<h2([^>]*)>([^<]*\?)<\/h2>/g, (match, attrs: string, label: string) => {
    if (attrs.includes('id=')) return match;
    const id = label.toLowerCase().replace(/&[^;]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    toc.push({ id, label });
    return `${toc.length === 1 ? '<!--toc-->' : ''}<h2${attrs} id="${id}">${label}</h2>`;
  });
}
const tocHtml =
  toc.length >= 3
    ? `<nav class="toc" aria-label="On this page"><p class="kf-title">On this page</p><ol>${toc
        .map((t) => `<li><a href="#${t.id}">${t.label}</a></li>`)
        .join('')}</ol></nav>`
    : '';
body = body.replace('<!--toc-->', tocHtml);

// First URL segment, so every /tours/... page highlights "Tours" in the nav.
const section = (path: string) => path.split('/')[1];
const nav = [
  { href: '/pricing/', label: 'Prices' },
  { href: '/tours/7-day-classic/', label: 'Tours' },
  { href: '/guides/driver-vs-train/', label: 'Guides' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
    {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <!-- Vercel Web Analytics: served once enabled in the Vercel dashboard (404s harmlessly locally). -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={section(Astro.url.pathname) === section(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    {crumbs.length > 0 && (
      <nav class="wrap crumbs" aria-label="Breadcrumb">
        <ol>
          {trail.map((c, i) => (
            <li>{i < trail.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}

    <main id="main" class="wrap">
      <Fragment set:html={body} />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="brand-foot">{site.name}</p>
          <p>{site.tagline}.</p>
          <p>{site.address.locality}, {site.address.region}, {site.address.countryName} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <p class="foot-head">Plan your trip</p>
          <ul>
            <li><a href="/pricing/">Private driver prices</a></li>
            <li><a href="/tours/7-day-classic/">7-day itinerary</a></li>
            <li><a href="/tours/10-day-highlights/">10-day itinerary</a></li>
            <li><a href="/tours/14-day-grand-tour/">14-day itinerary</a></li>
          </ul>
        </div>
        <div>
          <p class="foot-head">Guides</p>
          <ul>
            <li><a href="/guides/driver-vs-train/">Driver vs train vs tuk-tuk</a></li>
            <li><a href="/guides/airport-transfers/">Colombo airport transfers</a></li>
            <li><a href="/guides/tipping-and-driver-costs/">Tipping & driver costs</a></li>
            <li><a href="/faq/">FAQ</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
